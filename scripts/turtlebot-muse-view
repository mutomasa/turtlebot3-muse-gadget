#!/usr/bin/env bash
# Muse command wrapper for robot.view: snapshot the headless RViz2 and post it to Muse chat.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/ros_env.sh"
mapfile -t config_args < <(turtlebot_muse_config_args)
out="${XDG_RUNTIME_DIR:-/tmp}/turtlebot_view.png"
exec "$TURTLEBOT_MUSE_PYTHON" -m turtlebot3_muse.view_cli "${config_args[@]}" --out "$out" --send "$@"
